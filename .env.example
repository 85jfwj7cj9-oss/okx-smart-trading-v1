
# ==========================================
# OKX SMART TRADING V1.0
# Environment Variables Example
# ==========================================

# Application
APP_ENV=development
APP_SECRET_KEY=change-this-secret-before-deployment
ADMIN_API_KEY=change-this-admin-key
TIMEZONE=Asia/Taipei

# OKX Public Market Data
OKX_BASE_URL=https://www.okx.com

# Trading Scanner
SCAN_INTERVAL_SECONDS=60
TOP_N_SYMBOLS=100
BTC_BENCHMARK=BTC-USDT-SWAP

# Strategy
MIN_SIGNAL_SCORE=60
ENABLE_LONG=true
ENABLE_SHORT=true

# Risk Management - Simulation Only
INITIAL_EQUITY_USDT=1000
RISK_PER_TRADE_PERCENT=1
SIMULATED_LEVERAGE=5
TAKER_FEE_RATE=0.0005
SLIPPAGE_RATE=0.0005

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TO_USER_ID=
LINE_ENABLED=false

# Database
DATABASE_URL=
DATABASE_PATH=data/okx_trading.db
DATABASE_CONNECT_TIMEOUT=15

# Scheduler
SUMMARY_HOUR=21

# Safety
AUTO_TRADING_ENABLED=false
LIVE_ORDER_ENABLED=false
