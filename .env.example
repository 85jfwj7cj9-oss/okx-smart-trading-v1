# Application
APP_ENV=development
APP_SECRET_KEY=change-this-secret
ADMIN_API_KEY=change-this-admin-key
TIMEZONE=Asia/Taipei

# OKX Public Market Data
OKX_BASE_URL=https://www.okx.com
OKX_DEMO_MODE=true

# Trading Scanner
SCAN_INTERVAL_SECONDS=60
TOP_N_SYMBOLS=100
TIMEFRAMES=1H,4H,1D,1W
BTC_BENCHMARK=BTC-USDT-SWAP

# Strategy
MIN_SIGNAL_SCORE=60
ENABLE_LONG=true
ENABLE_SHORT=true

# Risk Management - Simulation Only
INITIAL_EQUITY_USDT=1000
RISK_PER_TRADE_PERCENT=1
SIMULATED_LEVERAGE=5
TAKER_FEE_RATE=0.0005
SLIPPAGE_RATE=0.0005

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TO_USER_ID=
LINE_ENABLED=false

# Database
DATABASE_URL=
